FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fuelbedPorosity
{
    type            explicitPorositySource;
    selectionMode   cellZone;
    cellZone        fuelbed;

    explicitPorositySourceCoeffs
    {
        type            DarcyForchheimer;
        selectionMode   cellZone;
        cellZone        fuelbed;

        // Ergun 식: eps=0.55, dp=0.07 m (쪼갠 장작)
        d               (37259.1 37259.1 37259.1);
        f               (135.24 135.24 135.24);

        coordinateSystem
        {
            type        cartesian;
            origin      (0 0 0);
            coordinateRotation
            {
                type    axesRotation;
                e1      (1 0 0);
                e2      (0 1 0);
            }
        }
    }
}

heatSource
{
    // 연료층 내부 분포 발열 — 공기가 연료층을 관통한다
    type            scalarSemiImplicitSource;
    selectionMode   cellZone;
    cellZone        fuelbed;
    volumeMode      absolute;

    injectionRateSuSp
    {
        h  (150000.0 0);
    }
}

limitT
{
    // 초기 과도에서 국부 온도가 튀어 thermo::calculate 가 터지는 것을 막는다.
    // 수렴해 확립된 해에는 걸리지 않아야 한다 — 걸린 셀이 남아 있으면
    // 그 해는 신뢰할 수 없다. log 의 "Lower/Upper limited" 를 확인할 것.
    type            limitTemperature;
    selectionMode   all;
    min             270;
    max             2600;
}
